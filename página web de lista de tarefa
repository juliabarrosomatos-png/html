<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Lista de tarefas</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>Lista de Tarefas</h1>
        <label for="tarefa" class="visually-hidden">Nova tarefa</label>
        <input type="text" id="tarefa" placeholder="Digite sua tarefa">
        <button id="adicionar" type="button">Adicionar</button>
        <p>Total de tarefas: <span id="contador">0</span></p>
        <ul id="lista"></ul>
    </div>

<style>
body {
    font-family: Arial;
    background-color:rgb(146, 22, 22);
}
.container{
    width: 400px;
    margin: auto;
    margin-top: 50px;
    background: white;
    padding: 20px;
    border-radius: 10px;
}

input{
    width: 70%;
    padding: 10px;
}

button{
    padding: 10px;
    cursor: pointer;
}

li {
    margin-top: 10px;
}
</style>
    <script>
        const input = document.getElementById('tarefa');
        const botao = document.getElementById('adicionar');
        const lista = document.getElementById('lista');
        const contador = document.getElementById('contador');

        function atualizarContador() {
            contador.textContent = lista.children.length;
        }

        function adicionarTarefa() {
            const texto = input.value.trim();
            if (texto === '') {
                return;
            }

            const item = document.createElement('li');
            item.textContent = texto;
            item.title = 'Clique para remover';

            item.addEventListener('click', function () {
                item.remove();
                atualizarContador();
            });

            lista.appendChild(item);
            input.value = '';
            input.focus();
            atualizarContador();
        }

        botao.addEventListener('click', adicionarTarefa);

        input.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                adicionarTarefa();
            }
        });
    </script>
</body>
</html>
